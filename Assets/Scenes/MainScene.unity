--- !u!114 &316516254
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 316516245}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: df4688c3391b51f4eb3a0759e3ef5bd1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestControls
  speechBubble: {fileID: 1172032735}
  talk: {fileID: 123795446}
  take: {fileID: 725287730}
  quests:
  - firstText: Greetings, child. I sense you seek the way out of this forest. Don't
      listen to whatever others say, only I know how to get out of here. I can fly,
      after all.
    secondText: 
    gratitude: 
    item: 
    questItem: 0
    finished: 0
    prize: {fileID: 0}
  - firstText: Now, bring me a hare foot, to prove you are capable.
    secondText: Did you bring the foot? Come closer and give it to me.
    gratitude: Ah, gorgeous item. Thank you.
    item: hare foot
    questItem: 2
    finished: 0
    prize: {fileID: 1535359799255520729, guid: 0ccdd1f51953ad9478b6575df216e3ba, type: 3}
  - firstText: Now we will have to get rid of others. Bring me Cat's claw, to make
      sure it won't sneak on us when I teach you how to fly.
    secondText: You've got the claw?
    gratitude: Splendid! Great job!
    item: Cat's claw
    questItem: 5
    finished: 0
    prize: {fileID: 0}
  - firstText: One last thing... We need to get rid of the Hunter, unless we want
      to get shot when flying away. Bring me his monocle.
    secondText: How's the Hunter?
    gratitude: Ah, yes, great job, child!
    item: Hunter's monocle
    questItem: 6
    finished: 0
    prize: {fileID: 3263355195957557238, guid: e9696ab1352a4a44ab79f6e925044070, type: 3}
  - firstText: 'Now let the first lesson begin: jump into this hole. Go on, don''t
      be shy.'
    secondText: 
    gratitude: 
    item: 
    questItem: 0
    finished: 0
    prize: {fileID: 0}
  prizeSpawn: {fileID: 225618847}
